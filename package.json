{
  "name": "numeric",
  "publisher": "nealbkn",
  "displayName": "numeric",
  "icon": "images/numeric.png",
  "description": "Hover to see numeric translations",
  "version": "0.0.10",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "license": "Apache-2.0",
  "repository": {
    "url": "https://github.com/nbbeeken/numeric"
  },
  "browser": "dist/numeric.js",
  "main": "dist/numeric.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "node ./.github/scripts/esbuild.js --minify",
    "compile": "node ./node_modules/typescript/bin/tsc",
    "watch": "node ./.github/scripts/esbuild.js --watch --sourcemap",
    "build": "node ./.github/scripts/esbuild.js --sourcemap",
    "package": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p -w . --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "release": "standard-version -i changelog.md",
    "publish": "vsce publish --oidc"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/vscode": "^1.146.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.1",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "standard-version": "^9.5.0",
    "typescript": "^6.0.3"
  }
}
